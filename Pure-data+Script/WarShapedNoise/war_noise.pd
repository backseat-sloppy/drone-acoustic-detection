#N canvas 20 30 760 640 12;
#X obj 20 40 cnv 15 330 580 empty empty 1\ \ NOISE 10 14 0 14 #e4ecf7 #303030 0;
#X obj 370 40 cnv 15 370 580 empty empty 2\ \ LEVEL\ AND\ OUTPUT 10 14 0 14 #efe6f6 #303030 0;
#X text 20 8 WAR-SHAPED NOISE - steady noise with the long-term spectrum of war recordings. 44.1 kHz. Details: docs/war_shaped_noise.md, f 100;
#X text 35 70 Seed picks the noise. Same seed = same noise. Train seeds 1-999 and test seeds 1000+., f 42;
#X msg 35 125 1;
#X msg 65 125 1001;
#X obj 160 125 r wsn-seed;
#X msg 35 160 seed \$1;
#X obj 35 195 noise~;
#X text 110 195 white noise, f 25;
#N canvas 760 80 640 560 shaper 0;
#X text 20 10 FFT shaping. 1024-point blocks with 4x overlap (hop 256). The block size must match --nfft in scripts/war_shaped_noise.py., f 80;
#X obj 20 60 block~ 1024 4;
#X obj 40 100 inlet~;
#X obj 100 130 tabreceive~ wsn-hann;
#X obj 40 165 *~;
#X text 260 165 analysis window (Hann), f 40;
#X obj 40 200 rfft~;
#X text 260 200 real part (left) and imaginary part (right) for bins 0..512, f 40;
#X obj 130 240 tabreceive~ wsn-gain;
#X obj 40 280 *~;
#X obj 90 280 *~;
#X text 260 270 both parts times the same real gain per bin = a zero-phase filter, f 40;
#X obj 40 320 rifft~;
#X text 260 320 unnormalised: forward + inverse = gain 1024, f 40;
#X obj 100 355 tabreceive~ wsn-hann;
#X obj 40 390 *~;
#X text 260 390 synthesis window (Hann), f 40;
#X obj 40 425 /~ 1536;
#X text 260 425 1536 = 1024 x 1.5. Hann squared overlap-added at hop N/4 sums to 1.5 (Pd's example I03 does the same). Measured: unit-gain table in = same RMS out., f 40;
#X obj 40 500 outlet~;
#X connect 2 0 4 0;
#X connect 3 0 4 1;
#X connect 4 0 6 0;
#X connect 6 0 9 0;
#X connect 6 1 10 0;
#X connect 8 0 9 1;
#X connect 8 0 10 1;
#X connect 9 0 12 0;
#X connect 10 0 12 1;
#X connect 12 0 15 0;
#X connect 14 0 15 1;
#X connect 15 0 17 0;
#X connect 17 0 19 0;
#X restore 35 235 pd shaper;
#X text 120 230 FFT shaping with the war spectrum (click to open), f 27;
#X obj 35 290 s~ wsn-shaped;
#X text 35 330 Gain per FFT bin from war_gain.txt (bins 0..512):, f 42;
#N canvas 0 50 450 250 (subpatch) 0;
#X array wsn-gain 513 float 2;
#X coords 0 10 512 0 290 130 1 0 0;
#X restore 35 360 graph;
#N canvas 760 80 560 520 init 0;
#X text 20 10 Runs once at load: read the gain table - build the Hann window - set defaults and turn DSP on., f 70;
#X obj 20 60 loadbang;
#X obj 20 90 t b b b;
#X msg 200 130 \; wsn-gain read war_gain.txt;
#X text 200 170 513 gains for FFT bins 0..512. Edit and click to reload after rebuilding the file., f 40;
#X msg 110 230 1024;
#X msg 160 230 0;
#X obj 110 260 until;
#X obj 110 290 f;
#X obj 150 290 + 1;
#X obj 110 320 t f f;
#X obj 110 350 expr 0.5-0.5*cos(2*3.14159265358979*\$f1/1024);
#X obj 110 380 tabwrite wsn-hann;
#X obj 110 200 t b b;
#N canvas 0 50 450 250 (subpatch) 0;
#X array wsn-hann 1024 float 2;
#X coords 0 1 1023 0 200 80 1 0 0;
#X restore 300 200 graph;
#X msg 20 430 \; pd dsp 1 \; wsn-level -20 \; wsn-monitor 0.1;
#X obj 300 330 samplerate~;
#X obj 300 360 sel 44100;
#X msg 370 390 Pd runs at \$1 Hz - the table is for 44100 Hz - set it in Media > Audio Settings, f 30;
#X obj 370 470 print WARNING;
#X connect 1 0 16 0;
#X connect 16 0 17 0;
#X connect 17 1 18 0;
#X connect 18 0 19 0;
#X connect 1 0 2 0;
