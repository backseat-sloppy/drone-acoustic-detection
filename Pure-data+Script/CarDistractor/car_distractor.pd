#X floatatom 25 205 7 0 1 1 road\ reflection\ (0.9\ asphalt) car-ground-show car-ground 0;
#X floatatom 25 235 7 0 1 1 ground\ to\ mic\ (0\ hard\ /\ 1\ grass) car-soft-show car-soft 0;
#X floatatom 25 265 7 0 5 1 weather\ loss\ C0\ dB\ (0-5) car-c0-show car-c0 0;
#X text 25 310 ENGINE REVS, f 20;
