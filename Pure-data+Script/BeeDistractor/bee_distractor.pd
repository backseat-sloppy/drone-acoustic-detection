#N canvas 20 33 1000 470 12;
#X obj 20 50 cnv 15 300 330 empty empty 1\ \ BEES 10 14 0 14 #f7f0d8 #303030 0;
#X obj 340 50 cnv 15 380 330 empty empty 2\ \ WHERE\ THEY\ FLY 10 14 0 14 #e6f2e6 #303030 0;
#X obj 740 50 cnv 15 240 330 empty empty 3\ \ LISTEN 10 14 0 14 #efe6f6 #303030 0;
#X text 20 8 BEE DISTRACTOR - real bee recordings with the background removed \, flying around near the microphone \, silent background. Details: docs/REPORT.md, f 125;
#X text 35 80 Kind of bee:, f 36;
#X obj 35 110 hradio 30 1 0 3 bee-type bee-type-show empty 0 -8 0 10 #fcfcfc #8a6a10 #303030 0;
#X symbolatom 35 150 20 0 0 0 - bee-title - 0;
#X floatatom 35 195 5 1 8 1 number\ of\ bees\ (1-8) bee-n-show bee-n 0;
#X floatatom 35 230 5 1 9999 1 variation\ (seed) bee-seed-show bee-seed 0;
#X text 35 265 Each bee has its own pitch and its own path. A new seed = new paths and pitches., f 34;
#X floatatom 355 85 7 0 100 1 distance\ to\ the\ bees\ m bee-dist-show bee-dist 0;
#X floatatom 355 115 7 0 30 1 height\ m bee-h-show bee-h 0;
#X floatatom 355 145 7 0 20 1 area\ they\ fly\ in\ +-\ m bee-area-show bee-area 0;
#X floatatom 355 175 7 0.05 10 1 flight\ speed\ m/s bee-speed-show bee-speed 0;
#X floatatom 355 205 7 0 100 1 loudness\ dB(A)\ at\ 1\ m\ per\ bee bee-level-show bee-level 0;
#X floatatom 355 235 7 1 600 1 file\ length\ s bee-dur-show bee-dur 0;
#X obj 355 270 bng 50 250 50 0 bee-go empty RECORD\ TO\ FILE 60 25 0 16 #fcfcfc #8a6a10 #303030;
#X text 355 330 type a value + Enter. The bees buzz all the time \; RECORD writes them to the file set by bee-rec., f 44;
#X msg 755 90 \; pd dsp 1;
#X msg 850 90 \; pd dsp 0;
#X text 755 125 sound on, f 10;
#X text 850 125 off, f 4;
#X obj 755 175 hsl 180 20 1 10000 1 0 bee-boost bee-boost-set speaker\ volume 0 -10 0 12 #fcfcfc #5a4a78 #303030 0 1;
#X symbolatom 755 220 12 0 0 0 - bee-state - 0;
#X floatatom 755 260 7 0 0 1 bee\ 1\ distance\ m bee-r - 0;
#X floatatom 755 295 7 0 0 1 dB\ SPL\ at\ mic bee-spl - 0;
#X text 755 335 Volume is speakers only \, not the file., f 26;
#N canvas 120 90 620 420 more-settings 0;
#X obj 10 10 cnv 15 600 400 empty empty MORE\ SETTINGS\ (defaults\ are\ fine\ for\ most\ uses) 10 14 0 14 #f2f2ec #303030 0;
#X text 25 50 WINGS, f 20;
#X floatatom 25 75 7 0.5 2 1 wingbeat\ pitch\ x\ (1\ =\ measured) bee-pitch-show bee-pitch 0;
#X floatatom 25 105 7 0 1 1 pitch\ glides\ (0\ steady\ /\ 1\ wild) bee-wobble-show bee-wobble 0;
#X text 25 160 MICROPHONE AND GROUND, f 30;
#X floatatom 25 185 7 0.1 20 1 microphone\ height\ m bee-mic-h-show bee-mic-h 0;
#X floatatom 25 215 7 0 1 1 ground\ reflection\ (0.6\ grass) bee-ground-show bee-ground 0;
#X msg 25 280 \; bee-pitch 1 \; bee-wobble 0.3 \; bee-mic-h 1.5 \; bee-ground 0.6;
#X text 330 75 Pitch moves every wingbeat harmonic (cold bee slower \, warm bee faster). Glides: each bee's pitch wanders up to +-4 % x this \, on top of the recording's own., f 36;
#X text 330 185 The ground reflects sound to the microphone., f 36;
#X text 330 330 <- click to reset these defaults, f 36;
#X restore 35 400 pd more-settings;
#X text 170 400 <- wingbeat pitch \, pitch glides \, microphone \, ground, f 60;
