#N canvas 100 60 620 620 12;
#X text 20 10 Random sampler - put .wav files in a "samples" folder next to this patch;
#X obj 20 40 bng 25 250 50 0 empty empty empty 17 7 0 10 -262144 -1 -1;
#X text 55 45 load random file + play;
#X msg 20 75 symbol samples/*.wav;
#X obj 20 105 file glob;
#X obj 20 135 t a a;
#X obj 20 165 list length;
#X obj 20 195 t b f;
#X obj 20 225 random;
#X msg 20 255 get \$1;
#X obj 20 285 list store;
#X obj 20 315 list trim;
#X msg 20 345 read -resize \$1 sample;
#X obj 20 375 soundfiler;
#X obj 20 405 t b;
#X obj 20 440 tabplay~ sample;
#X obj 20 480 *~;
#X obj 20 520 dac~;
#X obj 300 100 table sample;
#X obj 200 405 bng 25 250 50 0 empty empty empty 17 7 0 10 -262144 -1 -1;
#X text 235 410 replay;
#X symbolatom 160 315 28 0 0 0 - - - 0;
#X floatatom 160 450 5 0 100 0 - - - 0;
#X obj 160 480 dbtorms;
#X obj 160 510 pack f 20;
#X obj 160 540 line~;
#X obj 300 450 loadbang;
#X msg 300 480 90;
#X msg 300 40 \; pd dsp 1;
#X text 215 450 volume (dB);
#X connect 1 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 10 1;
#X connect 5 0 6 0;
