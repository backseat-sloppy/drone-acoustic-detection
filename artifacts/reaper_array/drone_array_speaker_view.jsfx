@init
N=39; NE=104; X=0; Y=100; ACC=200; LV=300; E=1000;
X[0]=-0.00; Y[0]=0.00; X[1]=-0.00; Y[1]=30.00; X[2]=-25.98; Y[2]=15.00; X[3]=-25.98; Y[3]=-15.00; X[4]=-0.00; Y[4]=-30.00; X[5]=25.98; Y[5]=-15.00; X[6]=25.98; Y[6]=15.00; X[7]=-0.00; Y[7]=60.00; X[8]=-35.27; Y[8]=48.54; X[9]=-57.06; Y[9]=18.54; X[10]=-57.06; Y[10]=-18.54; X[11]=-35.27; Y[11]=-48.54; X[12]=-0.00; Y[12]=-60.00; X[13]=35.27; Y[13]=-48.54; X[14]=57.06; Y[14]=-18.54; X[15]=57.06; Y[15]=18.54; X[16]=35.27; Y[16]=48.54; X[17]=-0.00; Y[17]=90.00; X[18]=-45.00; Y[18]=77.94; X[19]=-77.94; Y[19]=45.00; X[20]=-90.00; Y[20]=0.00; X[21]=-77.94; Y[21]=-45.00; X[22]=-45.00; Y[22]=-77.94; X[23]=-0.00; Y[23]=-90.00; X[24]=45.00; Y[24]=-77.94; X[25]=77.94; Y[25]=-45.00; X[26]=90.00; Y[26]=-0.00; X[27]=77.94; Y[27]=45.00; X[28]=45.00; Y[28]=77.94; X[29]=-0.00; Y[29]=120.00; X[30]=-70.53; Y[30]=97.08; X[31]=-114.13; Y[31]=37.08; X[32]=-114.13; Y[32]=-37.08; X[33]=-70.53; Y[33]=-97.08; X[34]=-0.00; Y[34]=-120.00; X[35]=70.53; Y[35]=-97.08; X[36]=114.13; Y[36]=-37.08; X[37]=114.13; Y[37]=37.08; X[38]=70.53; Y[38]=97.08;
E[0]=0; E[1]=1; E[2]=0; E[3]=2; E[4]=0; E[5]=3; E[6]=0; E[7]=4; E[8]=0; E[9]=5; E[10]=0; E[11]=6; E[12]=1; E[13]=2; E[14]=1; E[15]=6; E[16]=1; E[17]=7; E[18]=1; E[19]=8; E[20]=1; E[21]=16; E[22]=2; E[23]=3; E[24]=2; E[25]=8; E[26]=2; E[27]=9; E[28]=2; E[29]=10; E[30]=3; E[31]=4; E[32]=3; E[33]=10; E[34]=3; E[35]=11; E[36]=4; E[37]=5; E[38]=4; E[39]=11; E[40]=4; E[41]=12; E[42]=4; E[43]=13; E[44]=5; E[45]=6; E[46]=5; E[47]=13; E[48]=5; E[49]=14; E[50]=6; E[51]=14; E[52]=6; E[53]=15; E[54]=6; E[55]=16; E[56]=7; E[57]=8; E[58]=7; E[59]=16; E[60]=7; E[61]=17; E[62]=7; E[63]=18; E[64]=7; E[65]=28; E[66]=8; E[67]=9; E[68]=8; E[69]=18; E[70]=8; E[71]=19; E[72]=9; E[73]=10; E[74]=9; E[75]=19; E[76]=9; E[77]=20; E[78]=10; E[79]=11; E[80]=10; E[81]=20; E[82]=10; E[83]=21; E[84]=11; E[85]=12; E[86]=11; E[87]=21; E[88]=11; E[89]=22; E[90]=12; E[91]=13; E[92]=12; E[93]=22; E[94]=12; E[95]=23; E[96]=12; E[97]=24; E[98]=13; E[99]=14; E[100]=13; E[101]=24; E[102]=13; E[103]=25; E[104]=14; E[105]=15; E[106]=14; E[107]=25; E[108]=14; E[109]=26; E[110]=15; E[111]=16; E[112]=15; E[113]=26; E[114]=15; E[115]=27; E[116]=16; E[117]=27; E[118]=16; E[119]=28; E[120]=17; E[121]=18; E[122]=17; E[123]=28; E[124]=17; E[125]=29; E[126]=18; E[127]=19; E[128]=18; E[129]=29; E[130]=18; E[131]=30; E[132]=19; E[133]=20; E[134]=19; E[135]=30; E[136]=19; E[137]=31; E[138]=20; E[139]=21; E[140]=20; E[141]=31; E[142]=20; E[143]=32; E[144]=21; E[145]=22; E[146]=21; E[147]=32; E[148]=21; E[149]=33; E[150]=22; E[151]=23; E[152]=22; E[153]=33; E[154]=22; E[155]=34; E[156]=23; E[157]=24; E[158]=23; E[159]=34; E[160]=24; E[161]=25; E[162]=24; E[163]=34; E[164]=24; E[165]=35; E[166]=25; E[167]=26; E[168]=25; E[169]=35; E[170]=25; E[171]=36; E[172]=26; E[173]=27; E[174]=26; E[175]=36; E[176]=26; E[177]=37; E[178]=27; E[179]=28; E[180]=27; E[181]=37; E[182]=27; E[183]=38; E[184]=28; E[185]=29; E[186]=28; E[187]=38; E[188]=29; E[189]=30; E[190]=29; E[191]=38; E[192]=30; E[193]=31; E[194]=31; E[195]=32; E[196]=32; E[197]=33; E[198]=33; E[199]=34; E[200]=34; E[201]=35; E[202]=35; E[203]=36; E[204]=36; E[205]=37; E[206]=37; E[207]=38;
cnt=0;

@sample
i=0; loop(N, ACC[i] += sqr(spl(i)); i += 1;);
(cnt += 1) >= srate * 0.05 ? (
  i=0; loop(N, LV[i] = max(sqrt(ACC[i] / cnt), LV[i] * 0.6); ACC[i] = 0; i += 1;);
  cnt = 0;
);

@gfx 640 680
gfx_clear = 0;
s = min(gfx_w, gfx_h - 40) / 300; cx = gfx_w / 2; cy = 40 + (gfx_h - 40) / 2;
gfx_setfont(1, "Arial", max(10, 6 * s));
gfx_set(0.3, 0.3, 0.3, 1);
i=0; loop(NE, a=E[2*i]; b=E[2*i+1]; gfx_line(cx + X[a]*s, cy - Y[a]*s, cx + X[b]*s, cy - Y[b]*s); i += 1;);
best=0; bdb=-999; tot=0;
i=0; loop(N,
  tot += sqr(LV[i]);
  d = LV[i] > 0 ? 110 + 20 * log10(LV[i]) : -999;
  d > bdb ? (bdb = d; best = i;);
  k = min(1, max(0, (d - slider1) / (slider2 - slider1)));
  k > 0 ? gfx_set(0.35 + 0.65 * k, 0.25 + 0.7 * k * k, 0.2 * (1 - k), 1) : gfx_set(0.22, 0.22, 0.22, 1);
  gfx_circle(cx + X[i]*s, cy - Y[i]*s, (8 + 10 * k) * s, 1, 1);
  gfx_set(1, 1, 1, 1);
  sprintf(#n, "%d", i + 1); gfx_measurestr(#n, w, h);
  gfx_x = cx + X[i]*s - w / 2; gfx_y = cy - Y[i]*s - h / 2; gfx_drawstr(#n);
  i += 1;
);
gfx_set(0.8, 0.8, 0.8, 1);
#l = "front"; gfx_measurestr(#l, w, h); gfx_x = cx - w / 2; gfx_y = cy - 135 * s; gfx_drawstr(#l);
#l = "back"; gfx_measurestr(#l, w, h); gfx_x = cx - w / 2; gfx_y = cy + 128 * s; gfx_drawstr(#l);
gfx_x = cx - 148 * s; gfx_y = cy; gfx_drawstr("left");
#l = "right"; gfx_measurestr(#l, w, h); gfx_x = cx + 148 * s - w; gfx_y = cy; gfx_drawstr(#l);
gfx_set(1, 1, 1, 1); gfx_x = 10; gfx_y = 10;
tot > 0.000000000001 ? gfx_printf("loudest: speaker %d (%.0f dB SPL)    all 39: %.0f dB SPL", best + 1, bdb, 110 + 10 * log10(tot))
        : gfx_drawstr("silence");
